CTP_AUTH_URL=https://auth.[region].commercetools.com
CTP_API_URL=https://api.[region].commercetools.com
CTP_SESSION_URL=https://session.[region].commercetools.com
CTP_PROJECT_KEY=[composable-commerce-project-key]

CTP_CLIENT_ID=[composable-commerce-client-id]
CTP_CLIENT_SECRET=[composable-commerce-client-secret]

CTP_JWKS_URL=https://mc-api.[region].commercetools.com/.well-known/jwks.json
CTP_JWT_ISSUER=https://mc-api.[region].commercetools.com

BRAINTREE_MERCHANT_ID=[Braintree merchant id]
BRAINTREE_PUBLIC_KEY=[Braintree public key]
BRAINTREE_PRIVATE_KEY=[Braintree private key]
BRAINTREE_ENVIRONMENT=Sandbox#Production

BRAINTREE_AUTOCAPTURE=true
BRAINTREE_MERCHANT_ACCOUNT=[see https://developer.paypal.com/braintree/articles/control-panel/important-gateway-credentials#merchant-account-id-versus-merchant-id]

# Optional — custom type keys for the braintree custom fields shared with braintree-extension.
# For local tests if you use braintree-extension as well - set both same or keep unset.
# For deployments it is shared inside inheritAs.
#PAYMENT_TYPE_KEY=braintree-payment-type
#CUSTOMER_TYPE_KEY=braintree-customer-type
#PAYMENT_INTERACTION_TYPE_KEY=braintree-payment-interaction-type
#PAYMENT_TRANSACTION_TYPE_KEY=braintree-payment-transaction-type

#This part of environmental variables is only for processor
# Enable vault payment methods
STORED_PAYMENT_METHODS_ENABLED=true

MERCHANT_RETURN_URL=[Merchant-website-return-url]
LOCAL_PAYMENT_FALLBACK_URL=[Merchant-website-fallback-url] only required for local payment methods

# All keys are optional — include only what you need to override the defaults.
# paypal/paypalExpress buttonColor: gold|blue|silver|white|black
# paypal/paypalExpress buttonLabel: checkout|pay|buynow|paypal|installment|subscribe|donate
# paypal/paypalExpress shape: pill|rect
# paypal/paypalExpress size: small|medium|large|responsive
# googlePay buttonTheme: default|black|white   buttonType: book|buy|checkout|donate|order|pay|plain|subscribe
# googlePay totalPriceStatus: NOT_CURRENTLY_KNOWN|ESTIMATED|FINAL
# googlePay billingAddressFormat: FULL|MIN
# venmo desktopFlow: desktopWebLogin|desktopQRCode   paymentMethodUsage: multi_use|single_use
BRAINTREE_BUTTON_STYLES={"paypal":{"buttonColor":"gold","buttonLabel":"pay","payLater":true,"payLaterButtonColor":"gold","locale":"en_GB","shape":"pill","size":"responsive","tagline":true,"height":55,"billingAgreementDescription":"set your own billing agreement description"},"paypalExpress":{"buttonColor":"gold","buttonLabel":"buynow","payLaterButtonColor":"gold","locale":"en_GB","shape":"pill","size":"responsive","tagline":false,"height":55},"ach":{"mandateText":"set your own ACH mandate text - by clicking checkout you authorize [your business name] to debit your bank account"},"applePay":{"applePayDisplayName":"set your own store name"},"googlePay":{"buttonTheme":"black","buttonType":"buy","totalPriceStatus":"FINAL","billingAddressRequired":false,"billingAddressFormat":"MIN","phoneNumberRequired":false},"venmo":{"desktopFlow":"desktopWebLogin","mobileWebFallBack":true,"paymentMethodUsage":"multi_use","allowNewBrowserTab":true},"creditCard":{"showPostalCode":false,"showCardHoldersName":false,"continueOnLiabilityShiftPossible":false,"continueOnNoThreeDS":false}}

# Per-method required config (non-style identifiers, unique per payment method)
# creditCard.vaultLabel / paypal.vaultLabel: checkbox label text shown to logged-in customers; defaults to "Save my card" / "Save my PayPal account"
# ach.usBankAccountVerificationMethod: independent_check|instant_verification_account_validation|micro_transfers|network_check|tokenized_check — defaults to network_check if unset
BRAINTREE_PER_METHOD_CONFIG={"googlePay":{"googleMerchantId":"[your-google-merchant-id]","acquirerCountryCode":"[merchant-country-code]"},"venmo":{"profileId":"[optional-venmo-profile-id]"},"creditCard":{"vaultLabel":"Save my card"},"paypal":{"vaultLabel":"Save my PayPal account"},"ach":{"usBankAccountVerificationMethod":"network_check"}}

